# Usar solo caracteres ASCII en la contrasena: Spring lee este archivo como ISO-8859-1
DB_URL=jdbc:postgresql://localhost:5432/super-inter
DB_USERNAME=super_inter_app
DB_PASSWORD=cambiar_por_la_contrasena

# Secreto para firmar los tokens JWT: Base64 de al menos 32 bytes.
# Generarlo en Git Bash con: openssl rand -base64 32
JWT_SECRET=generar_con_openssl_rand_base64_32
# Tiempo de vida del token (por ejemplo 30m, 60m o 2h)
JWT_EXPIRACION=60m
