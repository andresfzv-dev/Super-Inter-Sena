# Este archivo es la configuración raíz; no busca otros lombok.config en carpetas superiores
config.stopBubbling = true

# Marca el código generado con @Generated para que las herramientas de cobertura lo ignoren
lombok.addLombokGeneratedAnnotation = true

# Prohibidas: generan setters sobre todos los atributos y rompen el encapsulamiento
lombok.data.flagUsage = error
lombok.setter.flagUsage = error